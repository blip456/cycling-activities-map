# Create an API application at https://www.strava.com/settings/api
#   Authorization Callback Domain: localhost
# Then copy this file to .env.local and fill in the values.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional. Leave unset and the app uses whatever origin you loaded it on, so
# `next dev -p 3111` just works. Only set this if you put the app behind a
# fixed hostname.
# APP_URL=http://localhost:3000
